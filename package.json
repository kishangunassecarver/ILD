{
  "name": "ilovedurban",
  "version": "1.0.0",
  "private": true,
  "description": "I Love Durban — the heartbeat of our city. Discover, connect, support local.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-reserved-routes.mjs && node scripts/fetch-wp-content.mjs",
    "check:routes": "node scripts/check-reserved-routes.mjs",
    "content": "node scripts/fetch-wp-content.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run build && wrangler deploy",
    "seed:export": "tsx scripts/export-seed.ts",
    "check:plugin": "node scripts/check-plugin.mjs",
    "plugin:zip": "node scripts/build-plugin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^0.469.0",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "php-parser": "^3.7.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "wrangler": "^4.125.0"
  }
}
