{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name on Cloudflare (the site at
  // ild.kishan-bde.workers.dev) — wrangler commands like `secret put` target
  // the Worker by this name.
  "name": "ild",
  "compatibility_date": "2026-08-20",
  // The site is a static export in out/. Assets are matched first, so a normal
  // page load never touches the Worker; only /api/* falls through to it.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker fronts every request: /api/* is the member API, and page
    // traffic passes through serveAsset, which guards against browsers landing
    // on raw .txt navigation payloads after a deploy (see worker/index.ts).
    "run_worker_first": true
  },
  // Listing photos uploaded from the owner dashboard, served back through
  // GET /api/media/*. KV rather than R2 only because R2 is not enabled on
  // this account — the storage calls are isolated in worker/business.ts.
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "a85c62e8f3d0485bb0a1b9441a2aa126"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ilovedurban",
      "database_id": "6b0144ca-3be6-4d1b-a9f8-b490f8b10626"
    }
  ],
  "vars": {
    "SITE_URL": "https://ild.kishan-bde.workers.dev"
  },
  // RESEND_API_KEY and MAIL_FROM are secrets, set with:
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put MAIL_FROM
  // Until they are set, sign-in links are written to the Worker log instead of
  // emailed, which keeps the flow testable.
  "observability": {
    "enabled": true
  }
}
