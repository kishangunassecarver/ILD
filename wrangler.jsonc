{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilovedurban",
  "compatibility_date": "2026-08-20",
  // Static-only deploy: `next build` with output: "export" emits plain files
  // into out/. No Worker script, so no SSR adapter is involved.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
